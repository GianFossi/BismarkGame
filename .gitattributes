# Normalize line endings for everyone, regardless of OS.
* text=auto eol=lf

*.fs text eol=lf
*.fsi text eol=lf
*.fsproj text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.mmd text eol=lf
# Binary-ish / generated — don't diff.
*.png binary
*.svg -text
*.pdf filter=lfs diff=lfs merge=lfs -text
docs/Parts/**/*.png filter=lfs diff=lfs merge=lfs -text
