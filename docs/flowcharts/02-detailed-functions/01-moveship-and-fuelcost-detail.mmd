    style Ok fill:#cfc
    style E1 fill:#fcc
    style E2 fill:#fcc
    style E3 fill:#fcc
    style E4 fill:#fcc
    style E5 fill:#fcc
    style E6 fill:#fcc
    style E7 fill:#fcc
    style E8 fill:#fcc
